# Servidor
PORT=3000
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pawspa_db

# JWT
JWT_SECRET=pawspa_jwt_secret_key_2024_secure_token
JWT_REFRESH_SECRET=pawspa_refresh_secret_key_2024_secure_token
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Autenticación
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
VERIFICATION_TOKEN_EXPIRES=15

# 2FA
TWO_FACTOR_ISSUER=PawSpa

# Frontend URL
FRONTEND_URL=http://localhost:5173