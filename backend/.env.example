# ====================================================================
# Pet Spa System - Configuración de Variables de Entorno
# ====================================================================
# Copia este archivo como .env y actualiza los valores
# cp .env.example .env

# ====================================================================
# BASE DE DATOS
# ====================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pawspa_db

# ====================================================================
# AUTENTICACIÓN JWT
# ====================================================================
# Genera secretos fuertes: openssl rand -hex 32
JWT_SECRET=tu_jwt_secret_super_fuerte_aqui_cambiar_en_produccion_12345
JWT_REFRESH_SECRET=tu_jwt_refresh_secret_super_fuerte_cambiar_produccion_67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ====================================================================
# SEGURIDAD
# ====================================================================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
EMAIL_VERIFICATION_EXPIRY_MINUTES=15

# ====================================================================
# SERVIDOR
# ====================================================================
PORT=3000
NODE_ENV=development
# CORS_ORIGIN=http://localhost:3001

# ====================================================================
# EMAIL (Para envío de emails de verificación)
# ====================================================================
# Usar Gmail + App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_email@gmail.com
# SMTP_PASS=tu_app_password

# O usar SendGrid
# SENDGRID_API_KEY=SG.xxxxx
# SENDER_EMAIL=noreply@pawspa.com
# SENDER_NAME=PawSpa System

# ====================================================================
# SERVICIOS EXTERNOS (Opcional)
# ====================================================================
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxx
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx

# ====================================================================
# LOGGING
# ====================================================================
# LOG_LEVEL=info
# LOG_FILE=logs/app.log

# ====================================================================
# Notas importantes:
# ====================================================================
# 1. NUNCA commites .env a git (está en .gitignore)
# 2. Los secretos JWT deben ser valores aleatorios largos (32+ caracteres)
# 3. En producción, usa variables de entorno del servidor
# 4. Cambia todas las contraseñas default
# 5. Usa HTTPS en producción
